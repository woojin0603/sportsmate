# tools/initialize_submission_mysql.ps1가 실제 파일을 자동 생성합니다.
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/sportmap_submission?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true&useSSL=false
spring.datasource.username=sportmap_app
spring.datasource.password=replace-database-password

app.auth.jwt-secret=replace-with-at-least-32-byte-secret
app.admin.initial-password=replace-with-strong-admin-password
app.import-key=replace-with-random-import-key
app.public-facility.service-key=replace-with-public-data-service-key

# 공개 HTTPS 배포 시 true로 변경합니다.
app.auth.secure-cookie=false

