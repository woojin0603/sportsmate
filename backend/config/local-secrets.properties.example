# 이 파일을 local-secrets.properties로 복사한 뒤 실제 값을 입력하세요.
# Gmail은 계정 비밀번호 대신 2단계 인증에서 만든 앱 비밀번호를 사용합니다.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your-account@gmail.com
spring.mail.password=your-app-password
app.mail.from=your-account@gmail.com

# 기존 로컬 비밀 설정 예시
app.auth.jwt-secret=replace-with-at-least-32-byte-secret
app.admin.initial-password=replace-admin-password
app.public-facility.service-key=replace-public-data-service-key

# 실제 이메일 발송을 켤 때만 설정 (로컬 기본은 실제 발송 없는 mock)
# app.mail.mode=live
# app.mail.public-base-url=https://your-public-domain.example
